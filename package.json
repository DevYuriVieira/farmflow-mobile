{
  "name": "farmflow",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/drawer": "^7.14.3",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.89.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "cypress": "^16.1.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:system": "jest __tests__/system",
    "test:acceptance": "jest __tests__/acceptance",
    "test:regression": "jest __tests__/regression",
    "test:functional": "jest __tests__/functional",
    "test:non-functional": "jest __tests__/non-functional",
    "test:blackbox": "jest __tests__/blackbox",
    "test:whitebox": "jest __tests__/whitebox",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:playwright": "playwright test",
    "test:e2e:playwright:ui": "playwright test --ui",
    "test:e2e:cypress": "cypress run",
    "test:e2e:cypress:open": "cypress open",
    "test:visual": "playwright test e2e/playwright/farmflow-visual-regression.spec.ts",
    "test:visual:update": "playwright test e2e/playwright/farmflow-visual-regression.spec.ts --update-snapshots",
    "test:visual:cypress": "cypress run --spec 'cypress/e2e/farmflow_visual_regression.cy.ts'",
    "test:k6": "k6 run k6/scenarios/load_test.js",
    "test:k6:stress": "k6 run k6/scenarios/stress_test.js",
    "test:k6:spike": "k6 run k6/scenarios/spike_test.js",
    "test:k6:sync": "k6 run k6/scenarios/offline_sync_test.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "jsx": "react-jsx",
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    }
  },
  "private": true
}
