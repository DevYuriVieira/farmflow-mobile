# FarmFlow Environment Variables Template
# Copy this file to .env or .env.local

# API Configuration
EXPO_PUBLIC_API_URL=https://api.farmflow.ag/v1
EXPO_PUBLIC_USE_MOCK_API=true
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Google OAuth Integration (Optional - for Google Calendar & Sign In)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Maps Configuration
EXPO_PUBLIC_MAPS_API_KEY=
